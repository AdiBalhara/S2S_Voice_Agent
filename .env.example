# TrijoTech Voice Sales Agent - Environment Variables
# Copy this file to .env and fill in your values.

# === Required ===

# Google Gemini API Key (Google AI Studio)
GEMINI_API_KEY=

# Supabase PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
SUPABASE_DATABASE_URL=

# === Model Configuration ===

# Gemini Live model for real-time voice conversations
GEMINI_LIVE_MODEL=gemini-2.0-flash-live-001

# Text model for request/response chat
GEMINI_TEXT_MODEL=gemini-3.8-flash

# Embedding model for vector search
EMBEDDING_MODEL=models/gemini-embedding-001

# === RAG Configuration ===

# Number of documents to retrieve per search
RAG_TOP_K=10

# Text chunking parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Vector dimension (768 for efficiency with gemini-embedding-001 MRL)
VECTOR_DIMENSION=768

# === Ingestion Configuration ===

# Custom sitemap URL (optional, defaults to {base_url}/sitemap.xml)
# SITEMAP_URL=

# Maximum pages to ingest
MAX_PAGES=100

# === LangSmith Tracing (Optional) ===

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=trijotech-voice-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# === Server Configuration ===

SERVER_HOST=0.0.0.0
SERVER_PORT=8000
